{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug test",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-k", "test_checkpointing", "-s", "-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {},
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Debug Training Script",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cs336_basics/training.py",
      "args": ["--data-path=data/tokens-owt_train.npy"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {},
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Debug Inference Script",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cs336_basics/inference.py",
      "args": [
        "--model-checkpoint=data/checkpoints/TinyStories-sweep-mxmkonws-final.pt",
        "--tokenizer=data/bpe-TinyStoriesV2-GPT4-train.pk",
        "--temperature=0.1",
        "--top-p=0.1"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {},
      "python": "${workspaceFolder}/.venv/bin/python"
    }
  ]
}
